{
  "brand": "Vamela",
  "version": "1.0.0",
  "description": "Production-ready design system tokens for Vamela, following Apple HIG and 8px grid principles.",
  "colors": {
    "primary": {
      "50": "#eff6ff",
      "100": "#dbeafe",
      "200": "#bfdbfe",
      "300": "#93c5fd",
      "400": "#60a5fa",
      "500": "#3b82f6",
      "600": "#2563eb",
      "700": "#1d4ed8",
      "800": "#1e40af",
      "900": "#1e3a8a",
      "950": "#172554"
    },
    "neutral": {
      "50": "#f8fafc",
      "100": "#f1f5f9",
      "200": "#e2e8f0",
      "300": "#cbd5e1",
      "400": "#94a3b8",
      "500": "#64748b",
      "600": "#475569",
      "700": "#334155",
      "800": "#1e293b",
      "900": "#0f172a",
      "950": "#020617"
    },
    "semantic": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    }
  },
  "typography": {
    "fontFamilies": {
      "sans": ["Inter", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"],
      "serif": ["Playfair Display", "Georgia", "serif"],
      "mono": ["JetBrains Mono", "Menlo", "monospace"]
    },
    "scale": {
      "level-9-display": { "fontSize": "4.5rem", "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" },
      "level-8-h1": { "fontSize": "3.75rem", "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" },
      "level-7-h2": { "fontSize": "3rem", "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "600" },
      "level-6-h3": { "fontSize": "2.25rem", "lineHeight": "1.3", "letterSpacing": "-0.01em", "fontWeight": "600" },
      "level-5-h4": { "fontSize": "1.875rem", "lineHeight": "1.4", "letterSpacing": "0", "fontWeight": "600" },
      "level-4-body-large": { "fontSize": "1.25rem", "lineHeight": "1.6", "letterSpacing": "0", "fontWeight": "400" },
      "level-3-body-base": { "fontSize": "1rem", "lineHeight": "1.5", "letterSpacing": "0", "fontWeight": "400" },
      "level-2-body-small": { "fontSize": "0.875rem", "lineHeight": "1.5", "letterSpacing": "0", "fontWeight": "400" },
      "level-1-caption": { "fontSize": "0.75rem", "lineHeight": "1.5", "letterSpacing": "0.02em", "fontWeight": "500" }
    }
  },
  "spacing": {
    "base": "8px",
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px",
      "32": "128px"
    }
  },
  "grid": {
    "columns": 12,
    "gutter": "24px",
    "margins": {
      "mobile": "16px",
      "tablet": "32px",
      "desktop": "auto"
    },
    "maxWidth": "1280px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "base": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
  },
  "radii": {
    "sm": "0.125rem",
    "base": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "3xl": "1.5rem",
    "full": "9999px"
  }
}
